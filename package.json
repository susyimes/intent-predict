{
  "name": "intent-predict",
  "version": "0.5.0",
  "private": true,
  "description": "Predict the user's next message as one intent from a closed catalog, or nothing. Phase 1 reference implementation (O1 x A1).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "python tools/validate.py",
    "sidecar": "node packages/sidecar/src/main.ts",
    "grok": "node packages/host-grok/src/main.ts",
    "e2e:grok": "node packages/host-grok/test/e2e.ts",
    "smoke:webui": "node packages/sidecar/test/webui-smoke.ts"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
