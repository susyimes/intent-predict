{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-predict.dev/spec/prediction.schema.json",
  "title": "EvaluationResult",
  "description": "Outcome of one pipeline evaluation: a delivered prediction, or null with exactly one suppression reason.",
  "$ref": "#/$defs/EvaluationResult",
  "$defs": {
    "SuppressedReason": {
      "type": "string",
      "enum": [
        "disabled",
        "non_interactive",
        "pending_interaction",
        "interrupted_turn",
        "failed_turn_unhandled",
        "mode_blocked",
        "incognito",
        "max_per_session_reached",
        "no_scenario_matched",
        "empty_catalog",
        "no_sampler",
        "budget_exhausted",
        "prompt_too_large",
        "sampler_error",
        "timeout",
        "aborted",
        "invalid_model_output",
        "unknown_intent",
        "model_none",
        "in_cooldown",
        "below_min_confidence",
        "slot_validation_failed",
        "output_invalid",
        "output_dangerous"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excerpt"
      ],
      "properties": {
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 301,
          "description": "Redacted end of the agent's final message (last 300 characters, prefixed with an ellipsis when truncated): the text a pass-through suggestion answers."
        }
      }
    },
    "Choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots",
        "text",
        "label"
      ],
      "properties": {
        "slots": {
          "type": "object"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 81,
          "description": "Redacted item text the choice stands for (e.g. the option the agent listed)."
        }
      }
    },
    "Alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "confidence",
        "slots",
        "text",
        "risk",
        "passThrough"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slots": {
          "type": "object"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "risk": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "reversible"
          ],
          "description": "side_effect intents are never offered as alternatives."
        },
        "passThrough": {
          "type": "boolean"
        },
        "action": {
          "$ref": "scenario-pack.schema.json#/$defs/ActionDescriptor"
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyMs"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sessionId",
        "sourceTurnId",
        "packId",
        "packVersion",
        "scenarioId",
        "qualifiedIntentId",
        "intent",
        "text",
        "locale",
        "risk",
        "passThrough",
        "confirmBeforeSend",
        "alternatives",
        "source",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceTurnId": {
          "type": "string",
          "minLength": 1,
          "description": "The completed turn this prediction answers. Dispatch is pinned to it."
        },
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "packVersion": {
          "type": "string",
          "minLength": 1
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedIntentId": {
          "type": "string",
          "minLength": 1,
          "description": "Versioned telemetry key '<packId>@<packVersion>/<scenarioId>#<intentId>'. Session state such as cooldown is keyed by the unversioned '<packId>/<scenarioId>#<intentId>'."
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "confidence",
            "slots"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "The model's self-reported probability; null when source is 'rule'."
            },
            "slots": {
              "type": "object"
            }
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Template-rendered suggestion. For an enumerated prediction this is the text of the preferred choice, else of the first choice."
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "risk": {
          "$ref": "scenario-pack.schema.json#/$defs/Risk"
        },
        "passThrough": {
          "type": "boolean"
        },
        "confirmBeforeSend": {
          "type": "boolean",
          "description": "True for side_effect intents: a surface must put a separate, explicit confirmation step between the user's choice and the send. There is no default; the core always sets it."
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "action": {
          "$ref": "scenario-pack.schema.json#/$defs/ActionDescriptor"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "description": "Present for enumerated predictions: one entry per listed item, in order."
        },
        "preferredChoice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "0-based index into choices that the agent marked as recommended. Surfaces must not preselect a choice when this is absent."
        },
        "alternatives": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Alternative"
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "rule",
            "model"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "passThrough"
            ],
            "properties": {
              "passThrough": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "context"
            ]
          }
        },
        {
          "if": {
            "required": [
              "risk"
            ],
            "properties": {
              "risk": {
                "const": "side_effect"
              }
            }
          },
          "then": {
            "properties": {
              "confirmBeforeSend": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "EvaluationResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "prediction"
          ],
          "properties": {
            "type": {
              "const": "completed"
            },
            "prediction": {
              "$ref": "#/$defs/Prediction"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "prediction",
            "suppressedReason"
          ],
          "properties": {
            "type": {
              "const": "completed"
            },
            "prediction": {
              "type": "null"
            },
            "suppressedReason": {
              "$ref": "#/$defs/SuppressedReason"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "error"
          ],
          "properties": {
            "type": {
              "const": "failed"
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Reserved for internal engine errors. Every expected non-delivery is 'completed' with prediction null."
        }
      ]
    }
  }
}
