{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-predict.dev/spec/events.schema.json",
  "title": "IntentPredictEvents",
  "description": "Normalized single-session (O1) events a host reports to the core. Every object needs a string 'type'; objects whose type is not defined here are accepted and ignored by the core (forward compatibility).",
  "$ref": "#/$defs/ObservedEvent",
  "$defs": {
    "ToolKind": {
      "type": "string",
      "enum": [
        "read",
        "search",
        "edit",
        "delete",
        "execute",
        "fetch",
        "ask_user",
        "other"
      ],
      "description": "Coarse tool category. When omitted on tool.call it is inferred from the tool name (SPEC 2.2)."
    },
    "TurnStartedEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "at"
      ],
      "properties": {
        "type": {
          "const": "turn.started"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch milliseconds."
        }
      }
    },
    "MessageUserEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "text"
      ],
      "properties": {
        "type": {
          "const": "message.user"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "hasAttachments": {
          "type": "boolean"
        }
      }
    },
    "MessageAgentEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "text"
      ],
      "properties": {
        "type": {
          "const": "message.agent"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "final": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "ToolCallEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "callId",
        "name"
      ],
      "properties": {
        "type": {
          "const": "tool.call"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "callId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ToolKind"
        },
        "command": {
          "type": "string",
          "description": "For execute-kind calls: the command line. Hosts SHOULD provide it; it is what lets the core tell a test/build/lint run from any other shell command."
        },
        "check": {
          "type": "boolean",
          "description": "Host-authoritative override: true if this call runs tests, a build, a linter or a type checker. When omitted the core classifies 'command' with the default pattern of SPEC 2.2."
        },
        "input": {}
      }
    },
    "ToolResultEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "callId",
        "status"
      ],
      "properties": {
        "type": {
          "const": "tool.result"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "callId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "denied"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "summary": {
          "type": "string",
          "description": "Single-line summary; may enter the compact transcript after redaction."
        },
        "output": {
          "description": "Optional structured output. Readable only through slot.from paths; never sent to a model."
        }
      }
    },
    "ArtifactEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "kind",
        "ref"
      ],
      "properties": {
        "type": {
          "const": "artifact"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "file_changed",
            "file_created",
            "file_deleted",
            "command_suggested",
            "link",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "StateEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "key",
        "value"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Host state key. The core reads mode, pendingApproval, pendingInput and incognito; any key is available to packs as state.<key>."
        },
        "value": {}
      }
    },
    "TurnCompletedEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "turnId",
        "status",
        "at"
      ],
      "properties": {
        "type": {
          "const": "turn.completed"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "errorCode": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AgentEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/TurnStartedEvent"
        },
        {
          "$ref": "#/$defs/MessageUserEvent"
        },
        {
          "$ref": "#/$defs/MessageAgentEvent"
        },
        {
          "$ref": "#/$defs/ToolCallEvent"
        },
        {
          "$ref": "#/$defs/ToolResultEvent"
        },
        {
          "$ref": "#/$defs/ArtifactEvent"
        },
        {
          "$ref": "#/$defs/StateEvent"
        },
        {
          "$ref": "#/$defs/TurnCompletedEvent"
        }
      ]
    },
    "UnknownEvent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "turn.started",
              "message.user",
              "message.agent",
              "tool.call",
              "tool.result",
              "artifact",
              "state",
              "turn.completed"
            ]
          }
        }
      },
      "description": "Any event type this version does not define. Accepted, never an error, never triggers an evaluation."
    },
    "ObservedEvent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentEvent"
        },
        {
          "$ref": "#/$defs/UnknownEvent"
        }
      ]
    }
  }
}
