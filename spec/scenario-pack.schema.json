{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-predict.dev/spec/scenario-pack.schema.json",
  "title": "ScenarioPack",
  "description": "Portable bounded-scenario intent catalog (v0.5, O1 x A1). An INTENTS.md front matter is exactly this object in YAML; the Markdown body maps to promptTemplate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "scenarios"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*$",
      "description": "Pack identifier, e.g. builtin/coding."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "SemVer string."
    },
    "description": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/GatePolicyPartial",
      "description": "Pack-level confidence thresholds. Packs and scenarios can only tighten the host policy (SPEC 3.3)."
    },
    "promptTemplate": {
      "type": "string",
      "description": "Classification prompt template (the Markdown body of an INTENTS.md). When absent the default prompt of SPEC 4.5 is used."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ScenarioSpec"
      }
    }
  },
  "$defs": {
    "Risk": {
      "type": "string",
      "enum": [
        "none",
        "read_only",
        "reversible",
        "side_effect"
      ],
      "description": "Declared risk of what the user's message asks for. none: conversation only; read_only: inspection; reversible: local, undoable work (edits, tests, local commit); side_effect: leaves the workspace (push, PR, deploy, messages). Irreversible requests are not expressible as intents in this version."
    },
    "SignalLeafPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "eq": {},
        "ne": {},
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "in": {
          "type": "array"
        },
        "contains": {},
        "matches": {
          "type": "string",
          "maxLength": 256,
          "description": "ECMA-262 regular expression source."
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "SignalPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/SignalPredicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/SignalPredicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/SignalPredicate"
            }
          }
        },
        {
          "$ref": "#/$defs/SignalLeafPredicate"
        }
      ]
    },
    "SlotSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "enum",
            "path"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 80
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "from": {
          "type": "string",
          "description": "Signal path resolved deterministically before any model-provided value."
        },
        "pattern": {
          "type": "string",
          "maxLength": 256,
          "description": "Regex the string form of the value must match; otherwise the prediction is discarded."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "default": 80
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {}
      }
    },
    "LocalizedTemplates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "RenderSpec": {
      "description": "The only source of user-visible suggestion text: a template, or templates keyed by locale. Placeholders are {slotName}.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/LocalizedTemplates"
        }
      ]
    },
    "ActionDescriptor": {
      "description": "Structured action the suggestion corresponds to. In this version only 'command' can be dispatched (as a slash command); 'tool' and 'custom' are metadata.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "command"
          ],
          "properties": {
            "type": {
              "const": "command"
            },
            "command": {
              "type": "string",
              "pattern": "^/[a-z][a-z0-9_-]{1,30}$"
            },
            "args": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "input"
          ],
          "properties": {
            "type": {
              "const": "tool"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "payload": {}
          }
        }
      ]
    },
    "Enumerate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "over"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1,
          "description": "Name of a declared number slot that receives the 1-based position of each item."
        },
        "over": {
          "type": "string",
          "minLength": 1,
          "description": "Signal path that must resolve to an array of 2-9 strings."
        },
        "preferred": {
          "type": "string",
          "description": "Optional signal path resolving to the 1-based position to preselect."
        }
      },
      "description": "Deterministic expansion of one intent into one choice per item of a signal array (SPEC 4.4 rule R2)."
    },
    "GatePolicyPartial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum model confidence for none/read_only/reversible intents. Default 0.60."
        },
        "sideEffectMinConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum model confidence for side_effect intents. Default 0.80."
        }
      }
    },
    "IntentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "render",
        "risk"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "const": "none"
          },
          "description": "Intent identifier, unique within its scenario; 'none' is reserved."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "when": {
          "$ref": "#/$defs/SignalPredicate"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SlotSpec"
          }
        },
        "enumerate": {
          "$ref": "#/$defs/Enumerate"
        },
        "render": {
          "$ref": "#/$defs/RenderSpec"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "passThrough": {
          "type": "boolean",
          "default": false,
          "description": "True when the message approves or continues whatever the agent just proposed (confirm, pick an option, go ahead, continue). Such intents are removed from the catalog when the agent's proposal looks like an external or destructive action, must declare risk reversible or higher, and must be shown together with the agent text they answer."
        },
        "action": {
          "$ref": "#/$defs/ActionDescriptor"
        }
      }
    },
    "ScenarioSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "match",
        "intents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "priority": {
          "type": "integer",
          "default": 0
        },
        "fallback": {
          "type": "boolean",
          "default": false,
          "description": "Fallback scenarios are considered only when no non-fallback scenario matches."
        },
        "triggerOnTurnStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ]
          },
          "default": [
            "completed"
          ]
        },
        "match": {
          "$ref": "#/$defs/SignalPredicate"
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/IntentSpec"
          }
        },
        "policy": {
          "$ref": "#/$defs/GatePolicyPartial"
        }
      }
    }
  }
}
