{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-predict.dev/spec/rpc.schema.json",
  "title": "IntentPredictRpc",
  "description": "JSON-RPC 2.0 messages between a host, the core and a surface (SPEC 8). Every request and notification is validated against the params of its method. Results are defined here per method but, as a JSON-RPC response carries no method name, they are validated by the caller.",
  "oneOf": [
    {
      "$ref": "#/$defs/JsonRpcRequest"
    },
    {
      "$ref": "#/$defs/JsonRpcNotification"
    },
    {
      "$ref": "#/$defs/JsonRpcSuccessResponse"
    },
    {
      "$ref": "#/$defs/JsonRpcErrorResponse"
    }
  ],
  "$defs": {
    "Id": {
      "description": "Ids of core-originated requests start with 's-'; hosts and surfaces must not use that prefix.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "RequestMethod": {
      "type": "string",
      "enum": [
        "initialize",
        "surface/attach",
        "prediction/act",
        "session/turn",
        "binding/list",
        "binding/bind",
        "sampler/sample",
        "dispatch/message",
        "dispatch/command"
      ]
    },
    "NotificationMethod": {
      "type": "string",
      "enum": [
        "session/observe",
        "prediction/cancel",
        "prediction/updated",
        "prediction/invalidated",
        "sampler/cancel",
        "binding/changed"
      ]
    },
    "JsonRpcRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "method": {
          "$ref": "#/$defs/RequestMethod"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "initialize"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/InitializeParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "surface/attach"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/SurfaceAttachParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "prediction/act"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/PredictionActParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session/turn"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/SessionTurnParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "binding/list"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/BindingListParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "binding/bind"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/BindingBindParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "sampler/sample"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/SamplerSampleParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "dispatch/message"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/DispatchMessageParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "dispatch/command"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/DispatchCommandParams"
              }
            }
          }
        }
      ]
    },
    "JsonRpcNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "$ref": "#/$defs/NotificationMethod"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "session/observe"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/SessionObserveParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "prediction/cancel"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/PredictionCancelParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "prediction/updated"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/PredictionUpdatedParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "prediction/invalidated"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/PredictionInvalidatedParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "sampler/cancel"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/SamplerCancelParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "binding/changed"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/BindingChangedParams"
              }
            }
          }
        }
      ]
    },
    "JsonRpcSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "JsonRpcError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32001,
            -32002,
            -32003,
            -32004
          ],
          "description": "JSON-RPC standard codes plus -32001 SESSION_BUSY, -32002 TURN_MISMATCH, -32003 SAMPLER_ABORTED, -32004 UNAUTHORIZED."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "data": {}
      }
    },
    "JsonRpcErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/JsonRpcError"
        }
      }
    },
    "Options": {
      "type": "object",
      "additionalProperties": false,
      "description": "Host runtime options. Every knob the SPEC names is set here or in 'policy'.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "blockedModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plan"
          ]
        },
        "settleMs": {
          "type": "integer",
          "minimum": 0,
          "default": 150
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 4000
        },
        "samplerMode": {
          "type": "string",
          "enum": [
            "compact",
            "fork"
          ],
          "default": "compact",
          "description": "Preferred mode when the host offers both."
        },
        "modelBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxCallsPerHour"
          ],
          "properties": {
            "maxCallsPerHour": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "maxPerSession": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownTurnsAfterDismiss": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "altMinConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15
        },
        "optionSets": {
          "type": "boolean",
          "default": true,
          "description": "Offer an option set when the model's first choice is below minConfidence but it and its runner-ups together reach it (SPEC 4.6)."
        },
        "mode": {
          "type": "string",
          "enum": [
            "open",
            "catalog"
          ],
          "default": "open",
          "description": "open: the session's own agent writes the user's likely next messages (SPEC 4.9). catalog: the closed-catalog pipeline (SPEC 4.3-4.8)."
        },
        "minCandidateConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15,
          "description": "Open mode: candidates below this confidence are not shown."
        },
        "redact": {
          "type": "string",
          "enum": [
            "default",
            "strict"
          ],
          "default": "default"
        },
        "serveSurface": {
          "type": "boolean",
          "default": true,
          "description": "Whether the core serves its bundled surface on loopback."
        }
      }
    },
    "InitializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "client",
        "capabilities"
      ],
      "properties": {
        "protocolVersion": {
          "const": "0.5"
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interactive": {
              "type": "boolean",
              "default": true
            },
            "samplerModes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "fork",
                  "compact"
                ]
              },
              "default": [],
              "description": "Empty means no sampler: only deterministic rules can produce predictions."
            },
            "dispatchModes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "message",
                  "command"
                ]
              },
              "default": [],
              "description": "How the host accepts a user-approved send from a surface. Empty means copy-only."
            },
            "surface": {
              "type": "boolean",
              "default": false,
              "description": "True when this connection also acts as a surface: it receives prediction/updated and prediction/invalidated and may call prediction/act."
            },
            "binding": {
              "type": "boolean",
              "default": false,
              "description": "True when the host answers binding/list and binding/bind, so a surface can point it at one of its existing agent sessions (SPEC 8)."
            }
          }
        },
        "packs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Built-in pack id or a file path. Naming a path is the explicit opt-in SPEC 3.2 requires."
              },
              {
                "$ref": "scenario-pack.schema.json"
              }
            ]
          }
        },
        "policy": {
          "$ref": "scenario-pack.schema.json#/$defs/GatePolicyPartial"
        },
        "options": {
          "$ref": "#/$defs/Options"
        }
      }
    },
    "InitializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "server",
        "loadedPacks"
      ],
      "properties": {
        "protocolVersion": {
          "const": "0.5"
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "loadedPacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "scenarioCount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "scenarioCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "surfaceUrl": {
          "type": "string",
          "description": "Loopback URL (including its access token) of the bundled surface, when the core serves one. The host should show or open it for the user."
        }
      }
    },
    "SessionObserveParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "events"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "events.schema.json#/$defs/ObservedEvent"
          }
        }
      }
    },
    "PredictionCancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "PredictionUpdatedParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "sourceTurnId",
        "result"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceTurnId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "prediction.schema.json#/$defs/EvaluationResult"
        },
        "trace": {
          "type": "object",
          "description": "Optional, implementation-defined diagnostics for inspector surfaces (matched scenario, threshold, redacted signals). Not part of conformance."
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch ms when the evaluation completed."
        }
      },
      "description": "Reports one evaluation. A result with prediction null never invalidates a live prediction; only prediction/invalidated does."
    },
    "PredictionInvalidatedParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "predictionId",
        "reason"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "predictionId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "turn_started",
            "resolved",
            "cancelled"
          ]
        }
      }
    },
    "SurfaceAttachParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 16,
          "description": "Per-launch access token. Required on every network transport."
        },
        "inspector": {
          "type": "boolean",
          "default": false,
          "description": "Ask for suppressed evaluations and 'trace' as well."
        }
      }
    },
    "SurfaceAttachResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sessionId"
            ],
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "live": {
                "$ref": "prediction.schema.json#/$defs/Prediction"
              },
              "recent": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/PredictionUpdatedParams"
                },
                "description": "The session's recent evaluations, oldest first, so a surface attaching after the fact can show them. Inspector attaches receive suppressed results as well; plain attaches only delivered ones."
              }
            }
          }
        },
        "dispatchModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "message",
              "command"
            ]
          }
        },
        "binding": {
          "type": "boolean",
          "description": "True when the host declared the binding capability, so the surface may offer session binding."
        },
        "bound": {
          "oneOf": [
            {
              "$ref": "#/$defs/BindingRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The agent session the host currently drives, when known at attach time."
        },
        "activeSessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The core session id the host currently observes under; it may name a session with no turn yet, which 'sessions' then still lists."
        }
      }
    },
    "PredictionActParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predictionId",
        "action"
      ],
      "properties": {
        "predictionId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "send",
            "copy",
            "dismiss"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "For 'send': the exact text the user approved (the rendered text, or the user's edit of it)."
        },
        "choice": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into prediction.choices the user picked."
        },
        "alternative": {
          "type": "string",
          "description": "intentId of the alternative the user picked."
        },
        "candidate": {
          "type": "integer",
          "minimum": 0,
          "description": "Open mode: index into prediction.candidates the user picked (default 0)."
        },
        "confirmed": {
          "type": "boolean",
          "description": "True only if the surface showed a separate confirmation step and the user accepted it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "send"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "not": {
            "required": [
              "choice",
              "alternative"
            ]
          }
        },
        {
          "not": {
            "required": [
              "candidate",
              "choice"
            ]
          }
        },
        {
          "not": {
            "required": [
              "candidate",
              "alternative"
            ]
          }
        }
      ]
    },
    "PredictionActResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "dispatched",
            "recorded",
            "stale",
            "busy",
            "confirmation_required",
            "unsupported",
            "failed"
          ]
        }
      }
    },
    "SessionTurnParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Ask for one retained turn of a session (SPEC 8). A turn that is not retained (any more) is -32602."
    },
    "TurnItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "user"
            },
            "text": {
              "type": "string",
              "maxLength": 2001
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "final"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "text": {
              "type": "string",
              "maxLength": 4001
            },
            "final": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "toolKind"
          ],
          "properties": {
            "kind": {
              "const": "tool"
            },
            "name": {
              "type": "string"
            },
            "toolKind": {
              "enum": [
                "read",
                "search",
                "edit",
                "delete",
                "execute",
                "fetch",
                "ask_user",
                "other"
              ]
            },
            "command": {
              "type": "string",
              "maxLength": 301
            },
            "status": {
              "enum": [
                "ok",
                "error",
                "denied"
              ]
            },
            "exitCode": {
              "type": "integer"
            },
            "summary": {
              "type": "string",
              "maxLength": 201
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifactKind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "artifactKind": {
              "type": "string"
            },
            "ref": {
              "type": "string",
              "maxLength": 201
            }
          }
        }
      ]
    },
    "SessionTurnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnId",
        "items"
      ],
      "description": "What happened in the turn, in event order. Every text is redacted (SPEC 7.1) and cut; tool output is never included.",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "startedAt": {
          "type": "number"
        },
        "completedAt": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnItem"
          }
        }
      }
    },
    "BindingListParams": {
      "type": "object",
      "additionalProperties": false,
      "description": "No parameters: the host returns everything it discovered; surfaces filter locally."
    },
    "BindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "cwd"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Host-defined session kind, e.g. 'grok'. A host binds only the kinds it can drive."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "The session's working directory; the host validates it before binding."
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Host-defined instance/profile name when the kind has them (e.g. a Hermes profile)."
        }
      }
    },
    "BindingSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "running",
        "bindable"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch ms of the latest known activity."
        },
        "running": {
          "type": "boolean",
          "description": "True when a live process is known to own the session; false when activity is inferred."
        },
        "bindable": {
          "type": "boolean",
          "description": "True when this host can bind the session with binding/bind."
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Host-defined instance/profile name when the kind has them; pass it back unchanged to binding/bind."
        }
      }
    },
    "BindingListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "sessions"
      ],
      "properties": {
        "current": {
          "oneOf": [
            {
              "$ref": "#/$defs/BindingRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The agent session the host currently drives, or null when none is bound."
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BindingSession"
          }
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The core session id under which the bound session's turns are observed."
        }
      }
    },
    "BindingBindParams": {
      "$ref": "#/$defs/BindingRef"
    },
    "BindingBindResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound",
        "sessionId"
      ],
      "properties": {
        "bound": {
          "$ref": "#/$defs/BindingRef"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The core session id under which post-bind turns are observed; binding starts fresh except for any replayed turns."
        },
        "replayedTurns": {
          "type": "integer",
          "minimum": 0,
          "description": "Completed turns restored from the bound session's store at bind time and observed under sessionId."
        }
      }
    },
    "BindingChangedParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound",
        "sessionId"
      ],
      "properties": {
        "bound": {
          "oneOf": [
            {
              "$ref": "#/$defs/BindingRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The core session id under which post-bind turns are observed."
        }
      },
      "description": "Pushed to attached surfaces when a binding takes effect, so an open surface refreshes without reloading."
    },
    "SamplerSampleParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "expectedTurnId",
        "mode",
        "prompt"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "expectedTurnId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "fork",
            "compact"
          ],
          "description": "'fork': append prompt to an ephemeral cache-sharing fork of the session. 'compact': run the self-contained prompt on the host's own model connection, without tools."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "jsonSchema": {
          "type": "object"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 120
        }
      }
    },
    "SamplerSampleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "null when the model tried to call a tool or produced no text."
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "SamplerCancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleRequestId",
        "sessionId"
      ],
      "properties": {
        "sampleRequestId": {
          "type": "string",
          "pattern": "^s-",
          "description": "JSON-RPC id of the in-flight sampler/sample request to abort."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DispatchMessageParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "text",
        "expectedTurnId",
        "predictionId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "User-approved text, to be handled exactly like a message the user typed."
        },
        "expectedTurnId": {
          "type": "string",
          "minLength": 1,
          "description": "The turn the suggestion answers. The host must refuse with TURN_MISMATCH unless this is the session's latest completed turn, and with SESSION_BUSY while a turn is running."
        },
        "predictionId": {
          "type": "string",
          "minLength": 1,
          "description": "Idempotency key: the host must never create two messages for the same predictionId."
        }
      }
    },
    "DispatchCommandParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "command",
        "expectedTurnId",
        "predictionId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_-]{1,30}$"
        },
        "args": {
          "type": "string",
          "maxLength": 1000
        },
        "expectedTurnId": {
          "type": "string",
          "minLength": 1
        },
        "predictionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DispatchResult": {
      "type": "object",
      "description": "An empty object: the host accepted the input and started (not queued) a turn for it."
    }
  }
}
